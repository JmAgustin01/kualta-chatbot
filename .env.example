# Copy to .env for local runs. On Render, set these under Environment.
# NEVER commit the real .env.

PORT=3000

# --- Embeddings ---
# gemini (default, free tier, uses GEMINI_API_KEY) or openai (needs credit)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Only if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Gemini (answers, and embeddings by default) ---
GEMINI_API_KEY=
# Pin a stable model ID. Check https://ai.google.dev/gemini-api/docs/models before demo day.
GEMINI_MODEL=gemini-3.6-flash
# Includes the model's thinking tokens, so leave headroom. Reply length is capped by the prompt (80 words).
MAX_OUTPUT_TOKENS=1024
# low | minimal | medium | high. Blank = model default. Low keeps replies fast and cheap.
GEMINI_THINKING_LEVEL=low

# --- Supabase pgvector ---
SUPABASE_URL=
# Service role key: server-side only. Never put this in a browser or public repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Retrieval tuning ---
# Top chunks sent to the LLM (lower = cheaper)
TOP_K=4
# Cosine similarity cutoff (0-1). Below this -> fallback/handoff, no LLM call.
# Calibrated for gemini-embedding-001 on 2026-11-09: off-topic 0.51-0.58, on-topic 0.63-0.74.
SIMILARITY_THRESHOLD=0.60

# --- Facebook Messenger (Meta app connected to the demo Page) ---
# Graph API version shown in your Meta app dashboard
GRAPH_API_VERSION=v25.0
# Meta app > Messenger > Messenger API Settings > Generate token (for the Page)
MESSENGER_PAGE_ACCESS_TOKEN=
# Any random string you choose; paste the same value into the webhook "Verify token" field
META_VERIFY_TOKEN=
# Meta app > App settings > Basic: App ID and App secret
META_APP_ID=
META_APP_SECRET=
# After someone replies from the Page inbox, the bot stays quiet for that customer this many hours
HUMAN_PAUSE_HOURS=12

# --- Test endpoint (/chat) ---
# Protects POST /chat used by the eval script. Leave blank to disable /chat entirely.
CHAT_API_KEY=

# --- Privacy ---
# Long random string. Messenger user IDs are hashed with it in sessions/logs. Don't change it after launch,
# or existing users' sessions and delete-my-data requests won't match their old records.
DATA_HASH_SALT=

# --- Business contact info used by the rules layer (fill from client) ---
CONTACT_EMAIL=
CONTACT_PHONE=
BUSINESS_HOURS=
FACEBOOK_PAGE_URL=https://m.me/1465752019951388
# Public web chat limits
WEB_CHAT_PER_MINUTE=15
WEB_CHAT_PER_DAY=2000
