{
  "name": "kualta-chatbot",
  "version": "1.0.0",
  "description": "Rules-first RAG support chatbot for Kualta Agency (Facebook Messenger + Supabase pgvector + Gemini Flash)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
